# Credentials
.env
.env.*
*.env
!.env.example
!config.env.example
!mcp-http-auth.env.example
!bridge-local.example.env
config.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/

# OS
.DS_Store
*.swp
*.swo

# Logs
*.log

# Generated service files (rendered from services/*.service.template at
# install/update time into $LOBSTER_WORKSPACE/services/ — a runtime dir
# outside the repo, never committed). This rule is a defensive backstop only;
# rendering should never target this in-repo services/ dir going forward.
services/*.service
!services/*.service.template

# Local configuration (use lobster.conf.example as template)
config/lobster.conf

# Runtime state (self-check rate limiting, etc.)
.state/

# Google Calendar credentials and tokens
config/google_credentials.json
config/calendar_tokens/
config/calendar_pending_flows/

# Runtime data (these dirs should not exist in the repo; kept as a safety net)
data/
memory/canonical/
memory/archive/digests/*.md

# Incident reports (generated at runtime by investigate-incident.sh)
incidents/*.md

# GSD framework (dev tooling, installed per-user)
.claude/agents/gsd-*.md
.claude/commands/
.claude/get-shit-done/
.claude/gsd-file-manifest.json
.claude/hooks/
.claude/package.json
.claude/settings.json

# Skill runtime data (PID files, local config)
config/camofox-browser/

# Planning artifacts
PLAN-*.md
.planning/

# Private user context overlay (lives in ~/lobster-workspace/.claude/, not here)
# Listed here as a safety net in case someone clones into the wrong place
.claude/user.md
.claude/user/

# Instance-specific / business-data files that currently exist untracked in
# some deployments (never committed, zero git history). Listed here as a
# defensive backstop so a future `git add -A` can't accidentally sweep them
# into the public repo. These belong in ~/lobster-user-config/ instead —
# see the PII remediation plan for the move-out plan for each.
hello-world.js
agents/eloso-test-manager.md
scripts/apollo_enrich.py
scripts/validate-temporal-token.py
scheduled-tasks/ism-workshop-reminder.sh
scheduled-tasks/outreach-queue-topup.sh
lobster-shop/buy-things/README.md
lobster-shop/paperclip/behavior/system.md
lobster-shop/paperclip/context/eloso-reference.md
lobster-shop/kissinger/context/reference.md

# Stray backup files (should never be committed)
*.bak

# Ad-hoc data dumps / exports / scratch output. These should be written to
# ~/lobster-workspace/, not the repo — see live_full_dump_now.json incident
# (2026-09): a raw Google Slides API dump landed in the repo root via an
# ad-hoc redirected command run with the wrong cwd, sat untracked and
# un-ignored, and was one `git add -A` away from being committed. Scoped to
# obvious dump/export/backup naming so legitimate tracked fixtures (e.g.
# tests/**/*.json, package.json) are unaffected — no tracked file in this
# repo currently matches any of these patterns (verified via `git ls-files`).
*dump*.json
*_dump
*-dump
*.dump
*export*.json
*_export
*-export
*_scratch*
*-scratch*
*_snapshot.json
*-snapshot.json
